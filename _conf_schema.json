{
  "api_list_gacha_url": {
    "description": "抓包得到的抽卡记录接口 URL。支持占位符 {token} {game_id} {limit} {offset}，{token} 会被替换为每个用户绑定的凭证",
    "type": "string",
    "default": "https://example.com/gacha/records?game_id={game_id}&page_size={limit}&authkey={token}"
  },
  "headers_json": {
    "description": "抓包得到的请求头（JSON 格式）。支持占位符 {token}，会被替换为用户绑定的凭证",
    "type": "text",
    "default": "{\n  \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\",\n  \"Accept\": \"application/json\"\n}"
  },
  "game_names": {
    "description": "游戏ID对应的显示名称（JSON 格式的键值对），如 {\"1\":\"原神\",\"2\":\"崩铁\"}",
    "type": "text",
    "default": "{\"1\":\"原神\",\"2\":\"崩坏：星穹铁道\",\"3\":\"绝区零\",\"4\":\"异环\",\"5\":\"无限暖暖\"}"
  },
  "default_game_id": {
    "description": "默认查询的游戏 ID",
    "type": "int",
    "default": 1
  },
  "limit": {
    "description": "单次请求最大条数",
    "type": "int",
    "default": 50
  }
}
